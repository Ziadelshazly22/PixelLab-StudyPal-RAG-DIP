# -------------------------------------------------------------------------
# .env.example -- Smart Learning Assistant
# Copy to .env and fill in your API keys before running the application.
#   cp .env.example .env
# -------------------------------------------------------------------------

# -- LLM backend selector ------------------------------------------------
# Options: groq (default, free tier) | ollama (local/campus)
LLM_BACKEND=groq
# ── Ollama (local LLM runtime for DeepSeek-R1-Distill-Qwen-14B) ──────────────
# Step 1: Install Ollama from https://ollama.com
# Step 2: Run in a separate terminal:
#         ollama pull deepseek-r1:14b
# Step 3: Start Ollama server:
#         ollama serve
# -- Primary LLM: Groq (free tier -- no billing required) -----------------
GROQ_API_KEY=your_groq_api_key_here
LLM_MODEL=llama-3.1-8b-instant

# -- Embeddings: local sentence-transformers (no API key required) ---------
# Uses all-MiniLM-L6-v2 by default, downloaded automatically on first run

# -- Vector store ---------------------------------------------------------
CHROMA_PERSIST_DIR=./data/chroma_db

# -- Server ---------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
RUN_UI=true
LOG_LEVEL=INFO